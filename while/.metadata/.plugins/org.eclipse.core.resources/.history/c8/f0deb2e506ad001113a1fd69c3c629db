package exercicios_lacos_repeticao;

import java.util.Scanner;

public class Exercicio5 {

	public static void main(String[] args) {
		
		Scanner entrada = new Scanner(System.in);
		
		int soma = 0;
		int num;
		
		while(true) {
			System.out.println("Informe um numero: ");
			num = entrada.nextInt();
			
			if(num<0) {
				break;
			}
			soma+=num;
		}

	}

}

package exercicios_lacos_repeticao;

import java.util.Scanner;

public class Exercicio10 {

	public static void main(String[] args) {
		
		Scanner entrada = new Scanner(System.in);
		
		 String nome;
	        double nota;
	        double somaNotas = 0;
	        int totalAlunos = 0;
	        char continuar = 'S';
	        
	        while (continuar == 'S') {
	            System.out.print("Digite o nome do aluno: ");
	            nome = entrada.nextLine();

	            System.out.print("Digite a nota do " + nome + ": ");
	            nota = entrada.nextDouble();
	            
	            somaNotas += nota;
	            totalAlunos++;

	            System.out.print("Deseja cadastrar outro aluno? (S/N): ");
	            continuar = entrada.next().toUpperCase().charAt(0);
	            
	            entrada.nextLine(); 
	            System.out.println(); 
	        }

	        if (totalAlunos > 0) {
	            double media = somaNotas / totalAlunos;
	            System.out.printf("Total de alunos cadastrados: ", totalAlunos);
	            System.out.printf("A média das notas informadas é: ", media);
	        } else {
	            System.out.println("Nenhum aluno foi cadastrado.");
	        }

	}

}
